// Multi-tenant e-commerce platform schema.
//
// Conventions:
// - Money columns end in "Cents" and hold integers in the currency's minor unit.
// - Rates end in "Bps" (basis points): 1000 = 10%.
// - Every merchant-owned row carries storeId; queries must always scope by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ACCOUNTS & TENANCY ============

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  password     String
  firstName    String?
  lastName     String?
  role         String          @default("merchant") // merchant, platform_admin
  stores       Store[]
  adminActions AdminAuditLog[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Store {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  ownerId     String
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  description String?
  logo        String?
  favicon     String?
  email       String?
  phone       String?

  status         String @default("draft") // draft, live, suspended
  currency       String @default("LKR")
  taxBps         Int    @default(0)
  // The platform's commission on each order's goods subtotal.
  platformFeeBps Int    @default(1000)

  // Stock at or below this counts as "low" for alerts.
  lowStockThreshold Int @default(5)

  templateKey  String @default("classic")
  pageSetupVersion Int @default(0)
  // Per-store order sequence, so customers see #1001 rather than a cuid.
  orderCounter Int    @default(1000)

  theme         StoreTheme?
  pages         StorePage[]
  modules       StoreModule[]
  domains       Domain[]
  products      Product[]
  orders        Order[]
  customers     Customer[]
  customerSessions CustomerSession[]
  payments      Payment[]
  ledger        LedgerEntry[]
  payouts       Payout[]
  payoutAccount PayoutAccount?
  subscribers   NewsletterSubscriber[]
  shippingZones ShippingZone[]
  discounts     Discount[]
  events        AnalyticsEvent[]
  stockChanges  InventoryAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// ============ STOREFRONT BUILDER ============

model StoreTheme {
  id      String @id @default(cuid())
  storeId String @unique
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  primaryColor   String @default("#111827")
  secondaryColor String @default("#ffffff")
  accentColor    String @default("#2563eb")
  fontFamily     String @default("Inter")
  headerStyle    String @default("standard") // minimal, standard, premium
  // Header/footer links and other template-wide settings.
  settings       Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A storefront page built from sections (see @repo/core sections.ts).
// Merchants edit draftSections; publishing copies them to publishedSections,
// which is the only version customers ever see.
model StorePage {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  slug              String
  title             String
  showInNavigation  Boolean @default(true)
  navigationPosition Int @default(0)
  draftSections     Json      @default("[]")
  publishedSections Json?
  publishedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
}

// Optional feature modules a store has switched on (see @repo/core modules.ts).
// Core modules are always on and have no row.
model StoreModule {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key     String
  enabled Boolean @default(true)
  config  Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, key])
}

// Custom domains. A domain serves the store only once ownership is verified
// through the DNS TXT record and a certificate has been issued.
model Domain {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  hostname          String    @unique // lowercase, no port, e.g. shop.example.lk
  status            String    @default("pending") // pending, verified, active, failed
  verificationToken String
  isPrimary         Boolean   @default(false)
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  lastError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// ============ CATALOG ============

model Product {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name                String
  slug                String
  description         String?
  status              String  @default("active") // draft, active, archived
  priceCents          Int
  compareAtPriceCents Int?
  quantity            Int     @default(0)
  category            String?
  sku                 String?
  // [{ name: "Size", values: ["S", "M"] }]. Products with options sell through variants;
  // quantity above is then unused and each variant carries its own stock.
  options             Json    @default("[]")

  images       ProductImage[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  stockChanges InventoryAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, category])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Display name built from option values, e.g. "M / Red".
  title        String
  // { "Size": "M", "Colour": "Red" }
  optionValues Json
  sku          String?
  // Overrides the product price when set.
  priceCents   Int?
  quantity     Int     @default(0)
  position     Int     @default(0)

  orderItems   OrderItem[]
  stockChanges InventoryAdjustment[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

// ============ CUSTOMERS & ORDERS ============

model Customer {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  firstName String?
  lastName  String?
  phone     String?
  googleSubject String?
  avatarUrl String?
  savedAddress Json?
  sessions CustomerSession[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
  @@unique([storeId, googleSubject])
}

// Customer sessions are separate from merchant and platform-admin accounts.
// Only a SHA-256 digest is stored; the random bearer token lives in an HttpOnly cookie.
model CustomerSession {
  id         String @id @default(cuid())
  storeId    String
  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([storeId, expiresAt])
}

model Order {
  id          String @id @default(cuid())
  storeId     String
  store       Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber Int

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status            String @default("pending") // pending, confirmed, cancelled, completed
  paymentStatus     String @default("unpaid") // unpaid, paid, partially_refunded, refunded, failed
  paymentMethod     String // card, cod, bank_transfer
  fulfillmentStatus String @default("unfulfilled") // unfulfilled, packed, shipped, delivered, returned

  currency         String
  subtotalCents    Int
  taxCents         Int    @default(0)
  shippingCents    Int    @default(0)
  discountCents    Int    @default(0)
  totalCents       Int
  // Fee rate and amount are frozen at checkout so later rate changes don't rewrite history.
  platformFeeBps   Int
  platformFeeCents Int
  merchantNetCents Int

  discountId       String?
  discount         Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountCode     String? // snapshot; null for automatic discounts
  discountTitle    String?
  shippingZoneName String?
  courier          String?
  trackingNumber   String?

  items           OrderItem[]
  shippingAddress ShippingAddress?
  payments        Payment[]
  ledger          LedgerEntry[]
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId, createdAt])
  @@index([storeId, status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Nullable so deleting a product never breaks past orders; name/sku/price are snapshots.
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantTitle   String?
  sku            String?
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
  @@index([productId])
}

model ShippingAddress {
  id         String  @id @default(cuid())
  orderId    String  @unique
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String
  line1      String
  line2      String?
  city       String
  district   String?
  postalCode String?
  country    String  @default("LK")
}

// ============ PAYMENTS & MONEY MOVEMENT ============

// One attempt to collect money for an order through a provider.
model Payment {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider    String // payhere, cod, bank_transfer
  providerRef String? // the provider's payment id
  amountCents Int
  currency    String
  status      String  @default("pending") // pending, succeeded, failed, refunded

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([storeId])
}

// Raw provider notifications, stored before processing so every event is
// handled exactly once and can be replayed.
model PaymentEvent {
  id          String    @id @default(cuid())
  provider    String
  eventKey    String // provider-unique id for idempotency
  payload     Json
  verified    Boolean
  processedAt DateTime?
  error       String?

  createdAt DateTime @default(now())

  @@unique([provider, eventKey])
}

// Append-only record of what the platform owes each merchant. A merchant's
// balance is the sum of amountCents; positive means the platform owes them.
//
// Card order paid:  +totalCents (sale), -platformFeeCents (platform_fee)
// COD order paid:   -platformFeeCents only, since the merchant already holds the cash
// Payout sent:      -amountCents (payout)
model LedgerEntry {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orderId     String?
  order       Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payoutId    String?
  payout      Payout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  // sale, platform_fee, refund, fee_reversal, payout, fee_payment (merchant paid fees owed), adjustment
  type        String
  amountCents Int
  currency    String
  memo        String?
  // Idempotency key such as "order:<id>:sale", so retried webhooks can't post twice.
  key         String  @unique

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([orderId])
}

model Payout {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  amountCents Int
  currency    String
  status      String        @default("pending") // pending, paid, failed
  reference   String? // bank transfer reference
  paidAt      DateTime?
  entries     LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

model PayoutAccount {
  id            String @id @default(cuid())
  storeId       String @unique
  store         Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  accountName   String
  bankName      String
  branch        String
  accountNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ MARKETING ============

model NewsletterSubscriber {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email   String

  createdAt DateTime @default(now())

  @@unique([storeId, email])
}

// ============ SHIPPING ============

// A delivery zone covers some districts at one rate. A district may belong to
// at most one zone; districts in no zone can't be delivered to.
model ShippingZone {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  districts     String[]
  rateCents     Int
  // Delivery is free when the discounted subtotal reaches this.
  freeOverCents Int?
  estimatedDays String? // e.g. "2-3 working days"
  position      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// ============ DISCOUNTS ============

model Discount {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  title            String
  // Uppercase code customers type; null for automatic discounts.
  code             String?
  type             String // percent, fixed, free_shipping
  // Basis points for percent, cents for fixed, unused for free_shipping.
  value            Int       @default(0)
  minSubtotalCents Int       @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  usedCount        Int       @default(0)
  active           Boolean   @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, code])
  @@index([storeId, active])
}

// ============ INVENTORY ============

// Every stock change with its reason, so merchants can see why numbers moved.
model InventoryAdjustment {
  id            String          @id @default(cuid())
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change        Int // +/- units
  quantityAfter Int
  reason        String // restock, correction, damaged, order, cancellation
  note          String?

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([productId])
}

// ============ ANALYTICS ============

// Raw storefront events. Roll these up into daily totals once volume grows.
model AnalyticsEvent {
  id        String  @id @default(cuid())
  storeId   String
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type      String // page_view, product_view, add_to_cart, checkout_start
  // Random per-browser id; no personal data.
  sessionId String
  path      String?
  productId String?

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([storeId, type, createdAt])
}

// ============ PLATFORM ADMIN ============

// Every action a platform admin takes on a merchant's store or money.
model AdminAuditLog {
  id      String  @id @default(cuid())
  actorId String
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  storeId String?
  action  String // store.suspend, store.reactivate, store.fee_rate, ledger.fee_payment, ledger.payout
  details Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([createdAt])
}
