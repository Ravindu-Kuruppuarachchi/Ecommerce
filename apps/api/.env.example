DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce"

# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=""

PORT=5000
NODE_ENV=development

DASHBOARD_URL="http://localhost:3000"
STOREFRONT_URL="http://localhost:3001"

# Public address of this API, used to build uploaded image URLs
PUBLIC_API_URL="http://localhost:5000"
# Where uploaded images are stored on disk (dev only; use object storage in production)
UPLOAD_DIR="uploads"
