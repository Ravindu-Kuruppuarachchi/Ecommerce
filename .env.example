# Docker Compose only; application settings live in their respective apps.
# pnpm env:setup creates a random password for a new local installation.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
# Optional `docker compose --profile tools up -d` database UI.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
