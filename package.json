{
  "name": "ecommerce-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant e-commerce SaaS platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "lint": "node --import tsx scripts/check-source.mjs",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm exec prisma migrate dev --schema=packages/database/schema.prisma",
    "db:seed": "pnpm --filter @repo/database seed",
    "db:studio": "pnpm exec prisma studio --schema=packages/database/schema.prisma",
    "db:generate": "pnpm --filter @repo/database generate",
    "test:templates": "node --import tsx packages/core/tests/templates.test.ts",
    "test:features": "node --import tsx scripts/verify-features.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "env:check": "node scripts/check-env.mjs",
    "db:deploy": "pnpm exec prisma migrate deploy --schema=packages/database/schema.prisma",
    "check": "pnpm env:check && pnpm lint && pnpm type-check && pnpm test:templates && pnpm test:setup",
    "audit:dependencies": "pnpm audit --prod",
    "test:setup": "node --test scripts/tests/setup-env.test.mjs"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.23.0",
    "turbo": "^2.9.14",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.3.3",
      "body-parser": "^1.20.9",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.1",
      "postcss": "^8.5.23",
      "nanoid@3": "^3.3.18",
      "source-map-js": "^1.2.2",
      "follow-redirects": "^1.16.2",
      "postcss-selector-parser@6": "^6.1.5",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "packageManager": "pnpm@10.34.5",
  "prisma": {
    "schema": "packages/database/schema.prisma"
  }
}
