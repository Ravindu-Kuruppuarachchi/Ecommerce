{
  "name": "ecommerce-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant e-commerce SaaS platform",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm exec prisma migrate dev --schema=packages/database/schema.prisma",
    "db:seed": "pnpm --filter @repo/database seed",
    "db:studio": "pnpm exec prisma studio --schema=packages/database/schema.prisma",
    "db:generate": "prisma generate"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.23.0",
    "turbo": "^1.10.16",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.3.3"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "packageManager": "pnpm@10.34.5",
  "prisma": {
    "schema": "packages/database/schema.prisma"
  }
}
